{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege grant for the main window: the 31 app commands of ARCHITECTURE.md §7.2, event listening only (drag-drop, session-changed, models-changed, show-keys; no emit), showing the window after first paint, dragging the custom title bar and setting the native theme to the in-app Light/Dark choice. No fs/shell/http/dialog/opener permissions: dialogs and reveal run in Rust.",
  "local": true,
  "windows": ["main"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-set-theme",
    "allow-get-app-info",
    "allow-get-session",
    "allow-reset-session",
    "allow-pick-reference-photo",
    "allow-set-reference-photo",
    "allow-set-reference-rotation",
    "allow-set-reference-crop",
    "allow-pick-source-folder",
    "allow-set-source-folder",
    "allow-clear-scan-cache",
    "allow-start-scan",
    "allow-cancel-job",
    "allow-get-photos",
    "allow-get-photo",
    "allow-set-review-decision",
    "allow-get-days",
    "allow-select-day-photo",
    "allow-move-photo-to-day",
    "allow-add-photo-to-day",
    "allow-set-day-excluded",
    "allow-start-align",
    "allow-get-frames",
    "allow-set-frame-adjustment",
    "allow-set-look",
    "allow-pick-export-folder",
    "allow-start-export-images",
    "allow-pick-video-path",
    "allow-start-export-video",
    "allow-reveal-path",
    "allow-set-video-settings",
    "allow-open-path"
  ]
}
