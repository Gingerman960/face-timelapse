{
  "name": "face-timelapse",
  "version": "1.0.0",
  "description": "Cross-platform desktop app that aligns a face across many photos to produce a smooth timelapse video",
  "main": "electron/main.js",
  "author": "Artem Kichihin",
  "license": "MIT",
  "homepage": "https://github.com/Gingerman960/face-timelapse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gingerman960/face-timelapse.git"
  },
  "bugs": {
    "url": "https://github.com/Gingerman960/face-timelapse/issues"
  },
  "keywords": [
    "electron",
    "react",
    "face-detection",
    "timelapse",
    "face-alignment",
    "procrustes",
    "face-api"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win",
    "postinstall": "electron-rebuild -f -w canvas,sharp || true",
    "download-models": "node scripts/download-models.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/face-api": "1.7.15",
    "canvas": "^3.0.0",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "sharp": "^0.34.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.3"
  }
}
